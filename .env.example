# Generate a private .env with: python3 scripts/init_env.py
# If copying this template manually, replace every __GENERATE__ value first.
DB_NAME=datapulse
DB_USER=datapulse
DB_PASSWORD=__GENERATE__
DB_ROOT_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
ACCESS_TOKEN_EXPIRE_MINUTES=30

# These ports avoid common 8000/8501 collisions. Keep PUBLIC_API_URL in sync.
BACKEND_PORT=8010
FRONTEND_PORT=8510
PUBLIC_API_URL=http://localhost:8010

# Optional first administrator; init_env.py generates its password privately.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__

# One simulator process for three temperature devices; each device reports every interval.
# Run exactly one worker. Generation continues without connected viewers.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=1
SIMULATOR_CATEGORY=temperature
SIMULATOR_THRESHOLD=80
REALTIME_BATCH_SIZE=100
REALTIME_FLUSH_INTERVAL_SECONDS=5
REALTIME_QUEUE_CAPACITY=1000
REALTIME_RETRY_INITIAL_SECONDS=0.1
REALTIME_RETRY_MAX_SECONDS=5
REALTIME_SHUTDOWN_TIMEOUT_SECONDS=10
# Initial WebSocket state; runtime start/stop commands do not restart REST API.
WS_ENABLED=true
WS_QUEUE_CAPACITY=100
WS_SEND_TIMEOUT_SECONDS=2
WS_AUTH_CHECK_INTERVAL_SECONDS=1
WS_MAX_CONNECTIONS=100
